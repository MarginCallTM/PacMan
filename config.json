# Pac-Man configuration.
# Lines whose first non-blank character is '#' are comments: they are
# blanked before JSON parsing (so JSON error line numbers still match).
# Unknown keys are ignored; wrong types fall back to the default and
# out-of-range values are clamped -- see README "Configuration".
{
    "highscore_filename": "highscores.json",
    # One {width, height} entry per level -- 10 levels minimum
    # (shorter arrays are padded with defaults). Width 15-41, height 10-41.
    "level": [
        {"width": 21, "height": 15},
        {"width": 21, "height": 15},
        {"width": 23, "height": 15},
        {"width": 23, "height": 17},
        {"width": 25, "height": 17},
        {"width": 25, "height": 19},
        {"width": 27, "height": 19},
        {"width": 27, "height": 21},
        {"width": 29, "height": 21},
        {"width": 31, "height": 23}
    ],
    "lives": 3,
    "pacgum": 42,
    "points_per_pacgum": 10,
    "points_per_super_pacgum": 50,
    "points_per_ghost": 200,
    # Level 1 is generated with this fixed seed (reproducible, per the
    # subject); every later level is randomly generated.
    "seed": 42,
    # Time limit per level, in seconds. On timeout: -1 life, timer refills.
    "level_max_time": 90
}
